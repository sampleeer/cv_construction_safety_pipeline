{
  "name": "CelebA API smoke scenario",
  "checks": [
    {
      "name": "health endpoint",
      "method": "GET",
      "path": "/health",
      "expect_status": 200,
      "expect_json": {
        "status": "ok"
      }
    },
    {
      "name": "model metadata endpoint",
      "method": "GET",
      "path": "/model",
      "expect_status": 200,
      "expect_keys": ["target_attribute", "algorithm", "feature_count", "metrics"]
    },
    {
      "name": "positive smiling prediction",
      "method": "POST",
      "path": "/predict",
      "json": {
        "features": {
          "Mouth_Slightly_Open": 1,
          "High_Cheekbones": 1,
          "Young": 1,
          "Attractive": 1,
          "Bags_Under_Eyes": 0,
          "Mustache": 0
        }
      },
      "expect_status": 200,
      "expect_keys": ["target_attribute", "prediction", "probability"]
    }
  ]
}
