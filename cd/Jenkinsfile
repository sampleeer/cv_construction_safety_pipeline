pipeline {
  agent any
  parameters {
    string(name: 'DOCKER_IMAGE', defaultValue: 'cv-mlops:local', description: 'Validated image tag/digest')
  }
  stages {
    stage('Deploy selected release') { steps { sh 'docker compose up -d --no-build api' } }
    stage('Smoke test') {
      steps { sh 'docker compose up --no-build --abort-on-container-exit --exit-code-from cd-tests cd-tests' }
    }
  }
  post {
    always { sh 'docker compose down --remove-orphans' }
  }
}
