pipeline {
  agent any
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Install') { steps { sh 'python -m pip install -r requirements-export.txt' } }
    stage('Quality') { steps { sh 'make lint typecheck test' } }
    stage('Model release validation') {
      steps {
        sh 'python scripts/download_model.py'
        sh 'python -m src.helmet.download'
        sh 'dvc repro'
        sh 'docker compose up --build --abort-on-container-exit --exit-code-from cd-tests cd-tests'
      }
    }
  }
  post {
    always {
      sh 'docker compose down --remove-orphans'
      junit allowEmptyResults: true, testResults: 'reports/junit.xml'
      archiveArtifacts allowEmptyArchive: true, artifacts: 'coverage.xml,reports/cv-benchmark.json,reports/helmet-quality.json,models/cv/manifest.json'
    }
  }
}
